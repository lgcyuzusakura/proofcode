DEV_AUTH_TOKEN=change-me
RUNNER_TOKEN=change-runner-token
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
RUNNER_ALLOW_WRITE=false
RUNNER_ALLOW_EXEC=false
RUNNER_ALLOWED_PROGRAMS=go,node,npm,npx,python3,pytest,git,rg
RUNNER_MAX_COMMAND_SECONDS=120
JEV_MODE=off
JEV_BASE_URL=http://host.docker.internal:8009
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.85
JEV_API_KEY=
POSTGRES_DB=proofcode
POSTGRES_USER=proofcode
POSTGRES_PASSWORD=proofcode
# Project data resources store these names, never the credential values.
# JSON examples: {"url":"jdbc:postgresql://host:5432/db","user":"user","password":"..."}
DATA_SECRET_PG_DEV=
# JSON example: {"host":"host","port":6379,"database":0,"password":"...","tls":false}
DATA_SECRET_REDIS_DEV=
# Base64 of 32 random bytes; required for PostgreSQL mutation and Redis recovery snapshots.
DATA_SNAPSHOT_KEY=
# Host ports can be overridden when these defaults are already in use.
PROOFCODE_POSTGRES_PORT=5432
PROOFCODE_REDIS_PORT=6379
PROOFCODE_ARTEMIS_CORE_PORT=61616
PROOFCODE_ARTEMIS_AMQP_PORT=5672
PROOFCODE_ARTEMIS_CONSOLE_PORT=8161
PROOFCODE_CONTROL_PORT=8080
PROOFCODE_WEB_PORT=3000
