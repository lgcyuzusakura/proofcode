DEV_AUTH_TOKEN=change-me
RUNNER_TOKEN=change-runner-token
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_WIRE_API=chat
MODEL_NAME=gpt-4.1-mini
# Estimated full window (input + output reserve + protocol overhead).
# Default leaves about 16k input, 2k output; values above 128000 are rejected.
PROOFCODE_MODEL_CONTEXT_TOKENS=18304
PROOFCODE_OUTPUT_RESERVE_TOKENS=2048
EMBEDDING_MODEL=text-embedding-3-small
RUNNER_ALLOW_WRITE=false
RUNNER_ALLOW_EXEC=false
RUNNER_ALLOWED_PROGRAMS=go,node,npm,npx,python3,pytest,git,rg
RUNNER_MAX_COMMAND_SECONDS=120
# Optional browser tool for ordinary CODE tasks (excluded from A-F).
RUNNER_BROWSER_ENABLED=false
# Administrator-managed stdio MCP catalog. Agent profiles select these aliases.
# Example: [{"name":"workspace","command":"proofcode-mcp","args":["-root","."]}]
# Server programs run with the Runner's OS permissions; configure trusted programs only.
RUNNER_MCP_SERVERS=[]
# User-configured remote MCP endpoints reject private addresses unless explicitly enabled.
PROOFCODE_MCP_ALLOW_PRIVATE_HOSTS=false
# Must exactly match the callback registered with the MCP OAuth provider.
PROOFCODE_MCP_OAUTH_REDIRECT_URI=http://localhost:8080/api/mcp/oauth/callback
# Docker uses an isolated headless browser. A native same-user local runner can
# use shared to operate the desktop-owned project tab.
RUNNER_BROWSER_MODE=isolated
RUNNER_BROWSER_EXECUTABLE=/usr/bin/chromium-browser
# Standard Docker blocks Chromium user namespaces. Its isolation is the non-root
# Runner container; use false on hosts where Chromium's sandbox is supported.
RUNNER_BROWSER_NO_SANDBOX=true
JEV_MODE=off
JEV_BASE_URL=http://host.docker.internal:8009
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.85
JEV_API_KEY=
POSTGRES_DB=proofcode
POSTGRES_USER=proofcode
POSTGRES_PASSWORD=proofcode
# Project data resources store these names, never the credential values.
# JSON examples: {"url":"jdbc:postgresql://host:5432/db","user":"user","password":"..."}
DATA_SECRET_PG_DEV=
# JSON example: {"host":"host","port":6379,"database":0,"password":"...","tls":false}
DATA_SECRET_REDIS_DEV=
# Base64 of 32 random bytes; required for account model-provider keys and data recovery snapshots.
DATA_SNAPSHOT_KEY=
PROOFCODE_PROVIDERS_ALLOW_PRIVATE_HOSTS=false
# Host ports can be overridden when these defaults are already in use.
PROOFCODE_POSTGRES_PORT=5432
PROOFCODE_REDIS_PORT=6379
PROOFCODE_ARTEMIS_CORE_PORT=61616
PROOFCODE_ARTEMIS_AMQP_PORT=5672
PROOFCODE_ARTEMIS_CONSOLE_PORT=8161
PROOFCODE_CONTROL_PORT=8080
PROOFCODE_WEB_PORT=3000
